    <string name="bump_power_title">Tasto di accensione</string>
    <string name="bump_power_desc">Android non dice alle app quando viene premuto il tasto di accensione, quindi l’animazione parte quando apre il menu di spegnimento o riattiva lo schermo.</string>
    <string name="bump_power_menu">Quando apre il menu di spegnimento</string>
    <string name="bump_power_menu_desc">Tieni premuto il tasto di accensione e il bordo risponde accanto mentre compare il menu.</string>
    <string name="bump_power_wake">Quando riattiva lo schermo</string>
    <string name="bump_power_wake_desc">Parte anche quando qualcos’altro riattiva lo schermo, come una notifica.</string>
    <string name="bump_power_needs_accessibility">Il tasto di accensione richiede il servizio di accessibilità: è così che l’app vede il menu di spegnimento e lo schermo che si riattiva.</string>
    <string name="bump_level_with_slider">Finché il cursore del volume è attivo, è lui a mostrare il volume.</string>
    <string name="step_sound_choose">Suono</string>
    <string name="step_sound_choose_desc">Toccane uno per sentirlo, o scegli un suono dal telefono. I suoni brevi funzionano meglio.</string>
