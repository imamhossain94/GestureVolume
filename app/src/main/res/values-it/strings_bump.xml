    <!-- What the Quick slider does about a press while the button animation is on: both, or pause -->
    <string name="slider_with_bump">Con l’animazione dei tasti</string>
    <string name="slider_with_bump_both">Mostra entrambi</string>
    <string name="slider_with_bump_pause">Metti in pausa</string>
    <string name="slider_with_bump_both_hint">Una pressione avvia l’animazione dei tasti e appare anche il cursore rapido, come indicato in Tasti del volume.</string>
    <string name="slider_with_bump_pause_hint">Una pressione avvia solo l’animazione dei tasti. Il cursore rapido non risponde ai tasti del volume e si apre comunque dalla barra.</string>
    <string name="slider_with_bump_open_animation">L’animazione dei tasti è attiva. Tocca per aprirne le impostazioni.</string>
    <string name="bump_slider_desc">Se il cursore rapido appare anche quando premi un tasto del volume.</string>
    <string name="bump_slider_keys_off">Tasti del volume del cursore rapido è su Disattivati, quindi non apparirà. Tocca per cambiarlo.</string>
