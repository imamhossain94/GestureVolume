<?xml version="1.0" encoding="utf-8"?>
<resources>
    <string name="volume_limited_by_system">Android blocca il volume qui. Accetta il suo avviso sull’udito per alzarlo ancora.</string>
    <string name="volume_method_title">Come si cambia il volume</string>
    <string name="volume_method_desc">Se il volume si ferma prima del massimo o torna indietro dopo uno scorrimento, prova un altro modo.</string>
    <string name="volume_method_auto">Automatico</string>
    <string name="volume_method_auto_desc">Imposta il livello esatto e controlla che resti. Se Android o le cuffie lo rifiutano o lo riportano indietro, la barra lo cambia come i tasti del volume.</string>
    <string name="volume_method_keys">Come i tasti del volume</string>
    <string name="volume_method_keys_desc">Ogni passo è una pressione del tasto del volume, quindi segue la trasmissione, il Bluetooth e le app con un volume proprio. Il livello mostrato si aggiorna un attimo dopo.</string>
    <string name="volume_method_precise">Solo livello esatto</string>
    <string name="volume_method_precise_desc">Imposta sempre il livello esatto, come le versioni precedenti.</string>
    <string name="visibility_a11y_title">Sopra a tutto</string>
    <string name="visibility_a11y_desc">Il servizio di accessibilità può disegnare la barra sopra la barra di stato e la fotocamera, anche nelle app che nascondono le finestre fluttuanti.</string>
    <string name="visibility_a11y_draw_title">Disegna con il servizio di accessibilità</string>
    <string name="visibility_a11y_draw_desc">La barra può stare sopra la barra di stato, a filo del bordo, e resta sullo schermo nelle app e nei video che nascondono le finestre fluttuanti delle altre app. Con il telefono bloccato si fa da parte.</string>
    <string name="bump_title">Animazione dei tasti</string>
    <string name="bump_card_subtitle">Lo schermo risponde a ogni tasto che premi</string>
    <string name="bump_enable_title">Anima i tasti del volume</string>
    <string name="bump_enable_desc">Il bordo dello schermo si incava accanto al tasto che premi e il cursore del volume ne esce, al posto di quello di sistema.</string>
    <string name="bump_needs_accessibility">Serve il servizio di accessibilità per rispondere subito ai tasti e nascondere il cursore di sistema. Senza, l’animazione segue il cursore di sistema un attimo dopo.</string>
    <string name="bump_needs_service">Attiva Gesture Volume nella schermata principale perché i tasti la riproducano.</string>
    <string name="bump_style_title">Animazione</string>
    <string name="bump_style_desc">Tutte le animazioni sono gratuite. Toccane una per vederla sul telefono qui sopra.</string>
