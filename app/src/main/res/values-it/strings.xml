    <string name="open_settings">Apri impostazioni</string>
    <string name="snap_to_edge">Aggancia al bordo</string>
    <string name="snap_to_edge_desc">Attivo: la barra vola verso il lato più vicino quando la rilasci e si ferma alla distanza dal bordo indicata sotto. Disattivo: resta esattamente dove l\'hai lasciata. L\'altezza è sempre tua.</string>
