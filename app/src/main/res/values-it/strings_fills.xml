    <string name="fill_effort">Impegno</string>
    <string name="effort_settings_desc">La pista come selettore dell’impegno, come quelli degli strumenti di programmazione con IA: si accende passando per Basso, Alto, Extra alto, Max e Ultra max man mano che il livello sale, e lavora più intensamente più sale. L’anteprima qui sopra la mostra.</string>
    <string name="effort_look">Aspetto</string>
    <string name="effort_look_steps">Gradini</string>
    <string name="effort_look_dots">Punti</string>
    <string name="effort_look_steps_desc">Una tacca per ogni livello, impilate lungo la pista come le tacche di un cursore, accese fino a quella su cui sei.</string>
    <string name="effort_look_dots_desc">Una barra accesa fino al livello, con il livello contato in punti accanto al suo nome.</string>
    <string name="effort_speed">Velocità</string>
    <string name="effort_labels">Nomi dei livelli</string>
    <string name="effort_labels_desc">Mostra il nome del livello sulla pista, oltre ad accenderlo.</string>
