    <string name="surge_speed">Velocità</string>
    <string name="surge_size">Dimensione</string>
    <string name="surge_size_desc">Sopra 1, più numerosi e più piccoli: più scie e blocchi, celle più piccole, un bordo più movimentato.</string>
    <string name="surge_edge">Bordo</string>
    <string name="surge_edge_desc">Quanto il fronte si allontana dal livello: da una linea dritta a curve profonde, lingue e gradini.</string>
    <string name="surge_glow">Bagliore</string>
    <string name="surge_trail">Scia</string>
    <string name="surge_trail_desc">Quanto indietro arriva la luce dal fronte prima di svanire nel buio.</string>
