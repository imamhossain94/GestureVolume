<?xml version="1.0" encoding="utf-8"?>
<resources>
    <string name="volume_limited_by_system">Android está reteniendo el volumen aquí. Acepta su aviso de audición para subirlo más.</string>
    <string name="volume_method_title">Cómo se cambia el volumen</string>
    <string name="volume_method_desc">Si el volumen se queda antes del máximo o vuelve atrás después de deslizar, prueba otra forma.</string>
    <string name="volume_method_auto">Automático</string>
    <string name="volume_method_auto_desc">Pone el nivel exacto y comprueba que se mantiene. Si Android o tus auriculares lo rechazan o lo devuelven, la barra lo cambia como los botones de volumen.</string>
    <string name="volume_method_keys">Como los botones de volumen</string>
    <string name="volume_method_keys_desc">Cada paso es una pulsación del botón de volumen, así que sigue al envío a pantalla, al Bluetooth y a las apps con su propio volumen. El nivel mostrado se pone al día un momento después.</string>
    <string name="volume_method_precise">Solo nivel exacto</string>
    <string name="volume_method_precise_desc">Siempre pone el nivel exacto, como las versiones anteriores.</string>
    <string name="visibility_a11y_title">Por encima de todo</string>
    <string name="visibility_a11y_desc">El servicio de accesibilidad puede dibujar la barra sobre la barra de estado y la cámara, y en apps que ocultan ventanas flotantes.</string>
    <string name="visibility_a11y_draw_title">Dibujar con el servicio de accesibilidad</string>
    <string name="visibility_a11y_draw_desc">La barra puede quedar sobre la barra de estado, pegada al borde, y sigue en pantalla en apps y vídeos que ocultan las ventanas flotantes de otras apps. Con el teléfono bloqueado se aparta.</string>
    <string name="bump_title">Animación de los botones</string>
    <string name="bump_card_subtitle">La pantalla responde a cada botón que pulsas</string>
    <string name="bump_enable_title">Animar los botones de volumen</string>
    <string name="bump_enable_desc">El borde de la pantalla se hunde junto al botón que pulsas y el control de volumen crece desde ahí, en lugar del control del sistema.</string>
    <string name="bump_needs_accessibility">Necesita el servicio de accesibilidad para responder a los botones al instante y ocultar el control del sistema. Sin él, la animación sigue al control del sistema un momento después.</string>
    <string name="bump_needs_service">Activa Gesture Volume en la pantalla de inicio para que los botones la reproduzcan.</string>
    <string name="bump_style_title">Animación</string>
    <string name="bump_style_desc">Todas las animaciones son gratis. Toca una para verla en el teléfono de arriba.</string>
