    <string name="bump_power_title">Botón de encendido</string>
    <string name="bump_power_desc">Android no avisa a las apps cuando se pulsa el botón de encendido, así que esto se muestra cuando abre el menú de apagado o enciende la pantalla.</string>
    <string name="bump_power_menu">Cuando abre el menú de apagado</string>
    <string name="bump_power_menu_desc">Mantén pulsado el botón de encendido y el borde responde a su lado mientras aparece el menú.</string>
    <string name="bump_power_wake">Cuando enciende la pantalla</string>
    <string name="bump_power_wake_desc">También se muestra cuando otra cosa enciende la pantalla, como una notificación.</string>
    <string name="bump_power_needs_accessibility">El botón de encendido necesita el servicio de accesibilidad: así ve la app el menú de apagado y el encendido de la pantalla.</string>
    <string name="bump_level_with_slider">Mientras el control de volumen está activado, es él quien muestra el volumen.</string>
