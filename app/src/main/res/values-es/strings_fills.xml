    <string name="level_feedback_title">Respuesta al nivel</string>
    <string name="level_feedback_desc">Cómo responde la animación al nivel: tranquila cuando está bajo, más viva a medida que sube y con un remate al llegar arriba.</string>
    <string name="level_feedback_follow">Más viva al llenarse</string>
    <string name="level_feedback_follow_desc">Se mueve más rápido y brilla más cuanto más alto está el nivel, con un destello al pasar cada quinto.</string>
    <string name="level_feedback_low">Brillo cuando está bajo</string>
    <string name="level_feedback_low_desc">Una luz suave respira en el nivel cuando está bajo, y abajo del todo cuando está apagado.</string>
