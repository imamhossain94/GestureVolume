    <string name="surge_size">Tamaño</string>
    <string name="surge_size_desc">Por encima de 1, más y más pequeños: más estelas y bloques, celdas más pequeñas y un borde más agitado.</string>
    <string name="surge_edge">Borde</string>
    <string name="surge_edge_desc">Cuánto se aleja el frente del nivel: de una línea recta a curvas profundas, lenguas y escalones.</string>
