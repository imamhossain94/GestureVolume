    <string name="fill_effort">Esfuerzo</string>
    <string name="effort_settings_desc">La pista como selector de esfuerzo, como los que muestran las herramientas de programación con IA: se ilumina pasando por Bajo, Alto, Extra alto, Máx. y Ultra máx. a medida que sube el nivel, y se esfuerza más cuanto más alto llega. La vista previa de arriba lo reproduce.</string>
    <string name="effort_look">Aspecto</string>
    <string name="effort_look_steps">Escalones</string>
    <string name="effort_look_dots">Puntos</string>
    <string name="effort_look_steps_desc">Una marca por nivel, apiladas a lo largo de la pista como las marcas de un control deslizante, encendidas hasta aquella en la que estás.</string>
    <string name="effort_look_dots_desc">Una barra encendida hasta el nivel, con el nivel contado en puntos junto a su nombre.</string>
    <string name="effort_speed">Velocidad</string>
    <string name="effort_labels">Nombres de nivel</string>
    <string name="effort_labels_desc">Muestra el nombre del nivel en la pista además de iluminarlo.</string>
