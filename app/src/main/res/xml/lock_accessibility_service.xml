<?xml version="1.0" encoding="utf-8"?>
<!--
  Deliberately the narrowest configuration an accessibility service can have.

  accessibilityEventTypes is omitted entirely, which subscribes the service to no events at all
  (there is no "typeNone" flag - absence is how you say it), and neither canRetrieveWindowContent
  nor canPerformGestures is requested: the service never reads the screen and never touches it. The
  one capability it uses is performGlobalAction(GLOBAL_ACTION_LOCK_SCREEN), which needs nothing
  declared here beyond being a connected service. Keeping it this narrow is both the right thing
  to do and what makes the Play Console accessibility declaration defensible.

  isAccessibilityTool="true" is the Console-facing half of that declaration, and it is an honest
  claim rather than a convenient one: this app exists to replace hardware buttons for people whose
  buttons are broken or who cannot press them, and this service is the power button's half of that
  - it turns the screen off for a user who cannot reach the physical key. Leaving the attribute off
  asserts the opposite ("not an accessibility tool"), which is what put the release into Play's
  prominent-disclosure-and-video track. Added in API 29; ignored on older platforms, which is fine
  because LockAccessibilityService.isSupported already gates the whole feature at API 28+.

  If the feature ever grows past locking the screen, revisit this attribute before shipping.
-->
<accessibility-service xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:accessibilityFeedbackType="feedbackGeneric"
    android:canPerformGestures="false"
    android:canRetrieveWindowContent="false"
    android:description="@string/lock_accessibility_description"
    android:isAccessibilityTool="true"
    android:notificationTimeout="0"
    android:summary="@string/lock_accessibility_summary"
    tools:targetApi="29" />
