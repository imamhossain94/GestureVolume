<resources>
    <string name="volume_limited_by_system">Android वॉल्यूम को यहीं रोक रहा है। और तेज़ करने के लिए उसकी सुनने से जुड़ी चेतावनी स्वीकार करें।</string>
    <string name="volume_method_title">वॉल्यूम कैसे बदला जाता है</string>
    <string name="volume_method_desc">अगर वॉल्यूम ऊपर तक पहुँचने से पहले रुक जाए या स्वाइप के बाद वापस लौट आए, तो दूसरा तरीका आज़माएँ।</string>
    <string name="volume_method_auto">अपने आप</string>
    <string name="volume_method_auto_desc">सटीक स्तर सेट करता है और जाँचता है कि वह बना रहे। अगर Android या आपके हेडफ़ोन उसे न मानें या वापस कर दें, तो बार वॉल्यूम बटन की तरह वॉल्यूम बदलता है।</string>
    <string name="volume_method_keys">वॉल्यूम बटन की तरह</string>
    <string name="volume_method_keys_desc">हर कदम वॉल्यूम बटन के एक दबाव जैसा है, इसलिए यह कास्टिंग, Bluetooth और अपने वॉल्यूम वाले ऐप्स के साथ चलता है। दिखाया गया स्तर थोड़ी देर बाद अपडेट होता है।</string>
    <string name="volume_method_precise">केवल सटीक स्तर</string>
    <string name="volume_method_precise_desc">पिछले संस्करणों की तरह हमेशा सटीक स्तर सेट करता है।</string>
    <string name="bump_title">बटन एनिमेशन</string>
    <string name="bump_card_subtitle">आप जो भी बटन दबाएँ, स्क्रीन जवाब देती है</string>
    <string name="bump_enable_title">वॉल्यूम बटन को एनिमेट करें</string>
    <string name="bump_enable_desc">दबाए गए बटन के पास वॉल्यूम स्तर के साथ एक एनिमेशन चलता है, सिस्टम के स्लाइडर की जगह।</string>
    <string name="bump_needs_accessibility">बटन पर तुरंत प्रतिक्रिया देने और सिस्टम का स्लाइडर छिपाने के लिए सुलभता सेवा चाहिए। इसके बिना एनिमेशन सिस्टम के स्लाइडर के थोड़ी देर बाद आता है।</string>
    <string name="bump_needs_service">बटन से इसे चलाने के लिए होम स्क्रीन पर Gesture Volume चालू करें।</string>
    <string name="bump_style_title">एनिमेशन</string>
