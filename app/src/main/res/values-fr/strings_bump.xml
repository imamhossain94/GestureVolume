<?xml version="1.0" encoding="utf-8"?>
<resources>
    <string name="volume_limited_by_system">Android bloque le volume ici. Acceptez son avertissement d’écoute pour monter plus haut.</string>
    <string name="volume_method_title">Comment le volume est changé</string>
    <string name="volume_method_desc">Si le volume s’arrête avant le maximum ou revient en arrière après un balayage, essayez une autre façon.</string>
    <string name="volume_method_auto">Automatique</string>
    <string name="volume_method_auto_desc">Règle le niveau exact et vérifie qu’il tient. Si Android ou vos écouteurs le refusent ou le remettent, la barre le change comme les boutons de volume.</string>
    <string name="volume_method_keys">Comme les boutons de volume</string>
    <string name="volume_method_keys_desc">Chaque pas est un appui sur le bouton de volume : il suit la diffusion, le Bluetooth et les applis qui ont leur propre volume. Le niveau affiché se met à jour un instant après.</string>
    <string name="volume_method_precise">Niveau exact seulement</string>
    <string name="volume_method_precise_desc">Règle toujours le niveau exact, comme les versions précédentes.</string>
    <string name="visibility_a11y_title">Au-dessus de tout</string>
    <string name="visibility_a11y_desc">Le service d’accessibilité peut dessiner la barre par-dessus la barre d’état et la caméra, et dans les applis qui masquent les fenêtres flottantes.</string>
    <string name="visibility_a11y_draw_title">Dessiner avec le service d’accessibilité</string>
    <string name="visibility_a11y_draw_desc">La barre peut se placer sur la barre d’état, contre le bord, et reste à l’écran dans les applis et les vidéos qui masquent les fenêtres flottantes des autres applis. Téléphone verrouillé, elle s’efface.</string>
    <string name="bump_title">Animation des boutons</string>
    <string name="bump_card_subtitle">L’écran répond à chaque bouton que vous pressez</string>
    <string name="bump_enable_title">Animer les boutons de volume</string>
    <string name="bump_enable_desc">Le bord de l’écran se creuse à côté du bouton pressé et le curseur de volume en sort, à la place de celui du système.</string>
    <string name="bump_needs_accessibility">Il faut le service d’accessibilité pour répondre aux boutons tout de suite et masquer le curseur du système. Sans lui, l’animation suit le curseur du système un instant après.</string>
    <string name="bump_needs_service">Activez Gesture Volume sur l’écran d’accueil pour que les boutons la jouent.</string>
    <string name="bump_style_title">Animation</string>
    <string name="bump_style_desc">Toutes les animations sont gratuites. Touchez-en une pour la voir sur le téléphone ci-dessus.</string>
