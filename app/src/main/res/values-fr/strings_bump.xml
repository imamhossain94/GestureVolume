    <string name="bump_power_title">Bouton Marche/Arrêt</string>
    <string name="bump_power_desc">Android ne dit pas aux applis quand le bouton Marche/Arrêt est pressé : l’animation se joue donc quand il ouvre le menu Marche/Arrêt ou réveille l’écran.</string>
    <string name="bump_power_menu">Quand il ouvre le menu Marche/Arrêt</string>
    <string name="bump_power_menu_desc">Maintenez le bouton Marche/Arrêt et le bord répond à côté pendant que le menu apparaît.</string>
    <string name="bump_power_wake">Quand il réveille l’écran</string>
    <string name="bump_power_wake_desc">Se joue aussi quand autre chose réveille l’écran, comme une notification.</string>
    <string name="bump_power_needs_accessibility">Le bouton Marche/Arrêt nécessite le service d’accessibilité : c’est ainsi que l’appli voit le menu Marche/Arrêt et l’écran qui se réveille.</string>
