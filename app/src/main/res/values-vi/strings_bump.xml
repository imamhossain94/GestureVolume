<?xml version="1.0" encoding="utf-8"?>
<resources>
    <string name="volume_limited_by_system">Android đang giữ âm lượng ở mức này. Chấp nhận cảnh báo về thính giác để tăng lớn hơn.</string>
    <string name="volume_method_title">Cách thay đổi âm lượng</string>
    <string name="volume_method_desc">Nếu âm lượng dừng trước mức tối đa hoặc bật về sau khi vuốt, hãy thử cách khác.</string>
    <string name="volume_method_auto">Tự động</string>
    <string name="volume_method_auto_desc">Đặt đúng mức và kiểm tra xem mức đó có giữ nguyên không. Nếu Android hoặc tai nghe từ chối hay trả về, thanh sẽ đổi âm lượng như các nút âm lượng.</string>
    <string name="volume_method_keys">Như các nút âm lượng</string>
    <string name="volume_method_keys_desc">Mỗi bước là một lần nhấn nút âm lượng, nên nó theo truyền màn hình, Bluetooth và các ứng dụng có âm lượng riêng. Mức hiển thị cập nhật sau đó một chút.</string>
    <string name="volume_method_precise">Chỉ đúng mức</string>
    <string name="volume_method_precise_desc">Luôn đặt đúng mức, như các phiên bản trước.</string>
    <string name="visibility_a11y_title">Trên mọi thứ</string>
    <string name="visibility_a11y_desc">Dịch vụ hỗ trợ tiếp cận có thể vẽ thanh lên trên thanh trạng thái và camera, cả trong các ứng dụng ẩn cửa sổ nổi.</string>
    <string name="visibility_a11y_draw_title">Vẽ bằng dịch vụ hỗ trợ tiếp cận</string>
    <string name="visibility_a11y_draw_desc">Thanh có thể nằm trên thanh trạng thái, sát mép, và vẫn hiện trong các ứng dụng và video ẩn cửa sổ nổi của ứng dụng khác. Khi điện thoại khóa, thanh sẽ tránh sang bên.</string>
    <string name="bump_title">Hiệu ứng nút</string>
    <string name="bump_card_subtitle">Màn hình đáp lại từng nút bạn nhấn</string>
    <string name="bump_enable_title">Tạo hiệu ứng cho nút âm lượng</string>
    <string name="bump_enable_desc">Một hiệu ứng chạy cạnh nút bạn nhấn, kèm mức âm lượng, thay cho thanh của hệ thống.</string>
    <string name="bump_needs_accessibility">Cần dịch vụ hỗ trợ tiếp cận để phản hồi nút ngay lập tức và ẩn thanh trượt của hệ thống. Nếu không có, hiệu ứng sẽ hiện theo thanh trượt của hệ thống sau một chút.</string>
    <string name="bump_needs_service">Bật Gesture Volume trên màn hình chính để các nút phát hiệu ứng này.</string>
