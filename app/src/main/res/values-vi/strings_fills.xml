    <string name="fill_glimmer">Lung linh</string>
    <string name="glimmer_settings_desc">Những chấm nhỏ sáng dần từ không có gì thành ánh lấp lánh khi đến gần mức hiện tại, nhấp nháy khi di chuyển, lấy cảm hứng từ thanh trượt nỗ lực dạng chấm trong các công cụ lập trình AI. Bản xem trước ở trên sẽ chạy nó.</string>
    <string name="glimmer_speed">Tốc độ</string>
    <string name="glimmer_handle">Tay nắm</string>
    <string name="glimmer_handle_desc">Một tay nắm ở mức hiện tại, như thanh trượt thường có. Tắt: các chấm chỉ dừng ở mức đó.</string>
    <string name="glimmer_stops">Vạch</string>
    <string name="glimmer_stops_desc">Sáu vạch mờ dọc theo rãnh, cách nhau mỗi một phần năm.</string>
    <string name="fill_surge">Sóng dâng</string>
    <string name="surge_settings_desc">Mức hiện tại là một đường phát sáng, ánh sáng lan ngược từ đó vào bóng tối, được chip đồ họa của điện thoại vẽ trực tiếp. Chọn một kiểu và tinh chỉnh; bản xem trước ở trên hiển thị ngay khi bạn chỉnh.</string>
