    <string name="surge_size">Größe</string>
    <string name="surge_size_desc">Über 1 mehr und kleiner: mehr Schlieren und Blöcke, kleinere Waben, eine unruhigere Kante.</string>
    <string name="surge_edge">Kante</string>
    <string name="surge_edge_desc">Wie weit die Front vom Pegel abweicht: von einer geraden Linie bis zu tiefen Kurven, Zungen und Stufen.</string>
    <string name="surge_glow">Leuchten</string>
    <string name="surge_trail">Schweif</string>
