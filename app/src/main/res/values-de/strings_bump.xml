<?xml version="1.0" encoding="utf-8"?>
<resources>
    <string name="volume_limited_by_system">Android hält die Lautstärke hier fest. Bestätige die Hörwarnung, um lauter zu werden.</string>
    <string name="volume_method_title">Wie die Lautstärke geändert wird</string>
    <string name="volume_method_desc">Wenn die Lautstärke vor dem Maximum stehen bleibt oder nach dem Wischen zurückspringt, probiere eine andere Art.</string>
    <string name="volume_method_auto">Automatisch</string>
    <string name="volume_method_auto_desc">Setzt den genauen Wert und prüft, ob er bleibt. Lehnen Android oder deine Kopfhörer ihn ab oder setzen ihn zurück, ändert die Leiste die Lautstärke wie die Lautstärketasten.</string>
    <string name="volume_method_keys">Wie die Lautstärketasten</string>
    <string name="volume_method_keys_desc">Jeder Schritt ist ein Druck auf die Lautstärketaste, daher folgt er Casting, Bluetooth und Apps mit eigener Lautstärke. Der angezeigte Wert zieht einen Moment später nach.</string>
    <string name="volume_method_precise">Nur genauer Wert</string>
    <string name="volume_method_precise_desc">Setzt immer den genauen Wert, wie frühere Versionen.</string>
    <string name="visibility_a11y_title">Über allem</string>
    <string name="visibility_a11y_desc">Der Bedienungshilfedienst kann die Leiste über der Statusleiste und der Kamera zeichnen, auch in Apps, die schwebende Fenster ausblenden.</string>
    <string name="visibility_a11y_draw_title">Mit dem Bedienungshilfedienst zeichnen</string>
    <string name="visibility_a11y_draw_desc">Die Leiste kann über der Statusleiste bündig am Rand sitzen und bleibt in Apps und Videos sichtbar, die schwebende Fenster anderer Apps ausblenden. Bei gesperrtem Telefon tritt sie zur Seite.</string>
    <string name="bump_title">Tastenanimation</string>
    <string name="bump_card_subtitle">Der Bildschirm antwortet auf jede Taste, die du drückst</string>
    <string name="bump_enable_title">Lautstärketasten animieren</string>
    <string name="bump_enable_desc">Neben der gedrückten Taste läuft eine Animation mit der Lautstärke – statt des Reglers des Systems.</string>
    <string name="bump_needs_accessibility">Braucht den Bedienungshilfedienst, um sofort auf die Tasten zu reagieren und den Regler des Systems auszublenden. Ohne ihn folgt die Animation dem Regler des Systems einen Moment später.</string>
    <string name="bump_needs_service">Schalte Gesture Volume auf dem Startbildschirm ein, damit die Tasten sie abspielen.</string>
    <string name="bump_style_title">Animation</string>
    <string name="bump_style_desc">Jede Animation ist kostenlos. Tippe auf eine, um sie oben auf dem Telefon zu sehen.</string>
