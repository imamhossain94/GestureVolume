    <!-- What the Quick slider does about a press while the button animation is on: both, or pause -->
    <string name="slider_with_bump">Mit der Tastenanimation</string>
    <string name="slider_with_bump_both">Beides zeigen</string>
    <string name="slider_with_bump_pause">Pausieren</string>
    <string name="slider_with_bump_both_hint">Ein Druck spielt die Tastenanimation, und der Schnellregler erscheint auch, wie unter Lautstärketasten eingestellt.</string>
    <string name="slider_with_bump_pause_hint">Ein Druck spielt nur die Tastenanimation. Der Schnellregler reagiert nicht auf die Lautstärketasten und öffnet sich weiter über die Leiste.</string>
    <string name="slider_with_bump_open_animation">Die Tastenanimation ist an. Tippen, um ihre Einstellungen zu öffnen.</string>
    <string name="bump_slider_desc">Ob der Schnellregler auch erscheint, wenn du eine Lautstärketaste drückst.</string>
    <string name="bump_slider_keys_off">Beim Schnellregler steht Lautstärketasten auf Aus, daher erscheint er nicht. Tippen, um das zu ändern.</string>
