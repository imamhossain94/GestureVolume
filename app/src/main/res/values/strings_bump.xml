<?xml version="1.0" encoding="utf-8"?>
<!--
  The button animation, the way the volume is written, and drawing the bar through the
  accessibility service. Kept out of strings.xml so the fifteen locales of these stay together.
-->
<resources>
    <!-- How the volume is changed (Actions › Behaviour) -->
    <string name="volume_limited_by_system">Android is holding the volume here. Accept its hearing warning to go louder.</string>
    <string name="volume_method_title">How the volume is changed</string>
    <string name="volume_method_desc">If the volume stops short of the top, or snaps back after a swipe, try another way.</string>
    <string name="volume_method_auto">Automatic</string>
    <string name="volume_method_auto_desc">Sets the exact level and checks it stayed. If Android or your headphones refuse it or put it back, the bar changes it the way the volume buttons do.</string>
    <string name="volume_method_keys">Like the volume buttons</string>
    <string name="volume_method_keys_desc">Every step is a press of the volume button, so it follows casting, Bluetooth and apps with their own volume. The level shown catches up a moment later.</string>
    <string name="volume_method_precise">Exact level only</string>
    <string name="volume_method_precise_desc">Always sets the exact level, as earlier versions did.</string>

    <!-- Drawing the bar through the accessibility service (Visibility) -->
    <string name="visibility_a11y_title">Above everything</string>
    <string name="visibility_a11y_desc">The accessibility service can draw the bar over the status bar and the camera, and in apps that hide floating windows.</string>
    <string name="visibility_a11y_draw_title">Draw with the accessibility service</string>
    <string name="visibility_a11y_draw_desc">The bar can sit over the status bar, flush with the edge, and stays on screen in apps and videos that hide other apps’ floating windows. While the phone is locked it steps aside.</string>

    <!-- The button animation -->
    <string name="bump_title">Button animation</string>
    <string name="bump_card_subtitle">The edge bulges at the volume buttons as you press them</string>
    <string name="bump_enable_title">Animate the volume buttons</string>
    <string name="bump_enable_desc">The edge of the screen bulges out beside the buttons as you press them, with the volume inside it, instead of the system’s slider.</string>
    <string name="bump_needs_accessibility">Needs the accessibility service to answer the buttons at once and hide the system’s slider. Without it, the animation follows the system’s slider a moment later.</string>
    <string name="bump_needs_service">Turn on Gesture Volume on the home screen for the buttons to play it.</string>
