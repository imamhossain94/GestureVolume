    <string name="troubleshoot_desc">Keep app alive on your device</string>
    <string name="troubleshoot_info">Aggressive battery optimization on some devices (like Xiaomi, Huawei, Oppo, Vivo) may kill background services. Follow these steps to ensure Gesture Volume runs reliably:</string>
