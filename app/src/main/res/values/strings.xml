    <string name="lock_accessibility_description">Allows GestureVolume to lock the screen when you use the Lock action on the floating bar. It locks the screen the same way the power button does, so your fingerprint still unlocks the phone. This service reads nothing on your screen and performs no other action.</string>
    <string name="lock_permission_title">Locking the screen</string>
