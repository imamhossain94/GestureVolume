<?xml version="1.0" encoding="utf-8"?>
<!--
  Counts the app shows in a summary line. Android picks the form for the current locale, which is
  why these are plurals rather than a format string with an "s" glued on: several of this app's
  fifteen locales have more than two forms, and one has none at all.
-->
<resources>
    <plurals name="deck_apps_pinned_count">
        <item quantity="one">%1$d pinned</item>
        <item quantity="other">%1$d pinned</item>
    </plurals>
    <plurals name="deck_quick_dial_count">
        <item quantity="one">%1$d contact</item>
        <item quantity="other">%1$d contacts</item>
    </plurals>
    <plurals name="deck_notes_count">
        <item quantity="one">%1$d saved</item>
        <item quantity="other">%1$d saved</item>
    </plurals>
    <plurals name="deck_clipboard_count">
        <item quantity="one">%1$d item</item>
        <item quantity="other">%1$d items</item>
    </plurals>
    <plurals name="deck_tiles_count">
        <item quantity="one">%1$d of %2$d on</item>
        <item quantity="other">%1$d of %2$d on</item>
    </plurals>
</resources>
