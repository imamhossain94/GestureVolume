<resources>
    <string name="volume_limited_by_system">Android ভলিউম এখানে আটকে রেখেছে। আরও বাড়াতে শ্রবণ সুরক্ষার সতর্কতা মেনে নিন।</string>
    <string name="volume_method_title">ভলিউম কীভাবে বদলানো হয়</string>
    <string name="volume_method_desc">ভলিউম সর্বোচ্চে পৌঁছানোর আগে থেমে গেলে বা সোয়াইপের পরে ফিরে গেলে অন্য উপায় চেষ্টা করুন।</string>
    <string name="volume_method_auto">স্বয়ংক্রিয়</string>
    <string name="volume_method_auto_desc">সঠিক মাত্রা সেট করে এবং তা টিকে আছে কিনা দেখে। Android বা আপনার হেডফোন তা না মানলে বা ফিরিয়ে দিলে, বার ভলিউম বোতামের মতো করে ভলিউম বদলায়।</string>
    <string name="volume_method_keys">ভলিউম বোতামের মতো</string>
    <string name="volume_method_keys_desc">প্রতিটি ধাপ ভলিউম বোতামে একবার চাপের মতো, তাই এটি কাস্টিং, Bluetooth এবং নিজস্ব ভলিউমের অ্যাপ অনুসরণ করে। দেখানো মাত্রা একটু পরে মিলে যায়।</string>
    <string name="volume_method_precise">শুধু সঠিক মাত্রা</string>
    <string name="volume_method_precise_desc">আগের সংস্করণগুলোর মতো সবসময় সঠিক মাত্রা সেট করে।</string>
    <string name="visibility_a11y_title">সবকিছুর উপরে</string>
    <string name="visibility_a11y_desc">অ্যাক্সেসিবিলিটি সার্ভিস বারটি স্ট্যাটাস বার ও ক্যামেরার উপরে আঁকতে পারে, এবং যেসব অ্যাপ ভাসমান উইন্ডো লুকায় সেখানেও।</string>
    <string name="visibility_a11y_draw_title">অ্যাক্সেসিবিলিটি সার্ভিস দিয়ে আঁকুন</string>
    <string name="visibility_a11y_draw_desc">বারটি কিনারায় লেগে স্ট্যাটাস বারের উপরেও থাকতে পারে, এবং যেসব অ্যাপ ও ভিডিও অন্য অ্যাপের ভাসমান উইন্ডো লুকায় সেখানেও স্ক্রিনে থাকে। ফোন লক থাকলে এটি সরে যায়।</string>
    <string name="bump_title">বোতাম অ্যানিমেশন</string>
    <string name="bump_card_subtitle">আপনি যে বোতামই চাপুন, স্ক্রিন সাড়া দেয়</string>
    <string name="bump_enable_title">ভলিউম বোতাম অ্যানিমেট করুন</string>
    <string name="bump_enable_desc">আপনি যে বোতাম চাপেন তার পাশে ভলিউম লেভেলসহ একটি অ্যানিমেশন চলে, সিস্টেমের স্লাইডারের বদলে।</string>
    <string name="bump_needs_accessibility">বোতামে সঙ্গে সঙ্গে সাড়া দিতে ও সিস্টেমের স্লাইডার লুকাতে অ্যাক্সেসিবিলিটি সার্ভিস লাগে। এটি ছাড়া অ্যানিমেশন সিস্টেমের স্লাইডারের একটু পরে আসে।</string>
    <string name="bump_needs_service">বোতামে এটি চালাতে হোম স্ক্রিনে Gesture Volume চালু করুন।</string>
