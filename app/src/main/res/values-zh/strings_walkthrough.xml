    <string name="walk_style_simple_title">简洁</string>
    <string name="walk_style_simple_desc">一个圆形按钮。滑动调节音量，点按打开音量面板。无需学习其他操作。</string>
    <string name="walk_style_advanced_title">高级</string>
    <string name="walk_style_advanced_desc">Dock 标签，带有快捷滑块、快捷方式 Deck 和长按菜单。</string>
    <string name="walk_style_simple_point_1">滑动 – 音量</string>
    <string name="walk_style_simple_point_2">点按 – 音量面板</string>
    <string name="walk_style_simple_point_3">按住 – 移动</string>
    <string name="walk_style_advanced_point_1">快捷滑块</string>
    <string name="walk_style_advanced_point_2">快捷方式 Deck</string>
    <string name="walk_style_advanced_point_3">长按菜单</string>
    <string name="walk_style_point_change">随时可以更改</string>
    <string name="walk_style_tour_chip">两种样式</string>
    <string name="walk_style_tour_title">两种使用方式</string>
    <string name="walk_style_tour_subtitle_simple">你当前使用的是简洁模式。点按“高级”看看它多了什么。要真正切换，请在主页中操作。</string>
    <string name="walk_style_tour_subtitle_advanced">你当前使用的是高级模式。点按“简洁”看看另一种方式。要真正切换，请在主页中操作。</string>
    <string name="walk_simple_chip">使用方法</string>
    <string name="walk_simple_title">滑动、点按、按住</string>
    <string name="walk_simple_subtitle">在按钮上向上或向下滑动即可调节音量。点按它打开音量面板。按住它即可移到任意位置。</string>
    <string name="walk_simple_caption">滑动 · 点按 · 按住</string>
    <string name="walk_simple_animation">手指滑动按钮调高音量，点按打开音量面板，然后按住按钮并移动它。</string>
    <string name="walk_simple_point_1">上滑 – 调大</string>
    <string name="walk_simple_point_2">下滑 – 调小</string>
    <string name="walk_simple_point_3">点按 – 音量面板</string>
    <string name="walk_simple_point_4">按住 – 移动</string>
    <string name="walk_slider_chip">快捷滑块</string>
    <string name="walk_slider_title">把滑条拉成滑块</string>
    <string name="walk_slider_subtitle">在滑条上向上或向下滑动，它就会变成一个全高度的音量滑块。继续滑动即可设置音量。</string>
    <string name="walk_slider_caption">滑动 · 拖动</string>
    <string name="walk_slider_animation">手指拖动滑条，滑条变成一个高高的音量滑块，音量随手指变化。</string>
    <string name="walk_slider_point_1">上滑 – 调大</string>
    <string name="walk_slider_point_2">下滑 – 调小</string>
    <string name="walk_slider_point_3">拖动 – 设置音量</string>
    <string name="walk_slider_point_4">全高度滑块</string>
    <string name="walk_deck_chip">DECK</string>
    <string name="walk_deck_title">快捷方式，一滑即达</string>
    <string name="walk_deck_subtitle">从滑条向内滑动即可打开 Deck：应用、开关、快速拨号等。</string>
    <string name="walk_deck_caption">向内滑动</string>
    <string name="walk_deck_animation">手指从滑条向内滑动，一个快捷磁贴面板随之滑入。</string>
    <string name="walk_deck_point_1">向内滑动 – 打开</string>
    <string name="walk_deck_point_2">应用</string>
    <string name="walk_deck_point_3">开关</string>
    <string name="walk_deck_point_4">快速拨号</string>
    <string name="walk_menu_chip">长按菜单</string>
    <string name="walk_menu_title">其他一切，按住即可</string>
    <string name="walk_menu_subtitle">按住滑条即可打开操作菜单：截屏、锁屏、手电筒等。按住并拖动可移动滑条。</string>
    <string name="walk_menu_caption">按住 · 拖动</string>
    <string name="walk_menu_animation">手指按住滑条，旁边打开一个操作网格。</string>
    <string name="walk_menu_point_1">按住 – 打开菜单</string>
    <string name="walk_menu_point_2">按住并拖动 – 移动</string>
    <string name="walk_menu_point_3">截屏和锁屏</string>
    <string name="walk_menu_point_4">手电筒等更多功能</string>
    <string name="walk_move_chip">移动</string>
    <string name="walk_move_title">放到拇指够得着的地方</string>
    <string name="walk_move_subtitle">按住滑条，直到它变暗并显示箭头，然后拖到任意位置：向上、向下，或横跨到另一侧。松手后它会停靠在较近的边缘。</string>
    <string name="walk_move_caption">按住 · 拖动 · 松手</string>
    <string name="walk_move_animation">手指按住滑条直到出现箭头，将它向下并横跨屏幕拖动，然后松手，滑条停靠在另一侧边缘。</string>
    <string name="walk_move_point_1">按住 – 拿起</string>
    <string name="walk_move_point_2">拖动 – 任意位置</string>
    <string name="walk_move_point_3">松手 – 自动贴边</string>
    <string name="walk_move_point_4">停在你放下的位置</string>
    <string name="walk_permission_chip">权限</string>
    <string name="walk_permission_title">允许滑条显示在屏幕上</string>
    <string name="walk_permission_subtitle">Android 需要你允许 Gesture Volume 显示在其他应用之上，这样滑条才能悬浮在它们上面。</string>
    <string name="walk_permission_animation">“显示在其他应用之上”开关开启，滑条出现在屏幕边缘。</string>
    <string name="walk_permission_point_1">显示在其他应用之上</string>
    <string name="walk_permission_point_2">让滑条保持在最上层</string>
    <string name="walk_permission_point_3">只需在设置中打开一个开关</string>
    <string name="walk_permission_point_4">随时可以关闭</string>
    <string name="walk_notif_chip">通知</string>
    <string name="walk_notif_title">通知中的控制按钮</string>
    <string name="walk_notif_subtitle">可选。允许通知后，滑条的控制按钮会留在通知栏中：隐藏或显示滑条、打开设置或停止服务，即使应用已关闭也可以。</string>
    <string name="walk_notif_animation">在通知权限请求中点按“允许”，通知栏下拉，里面有滑条的控制按钮。</string>
    <string name="walk_notif_card">应用关闭时，这是找回已隐藏滑条的唯一方式。Gesture Volume 不会发送其他任何通知。</string>
    <string name="walk_notif_granted">通知已开启 ✓</string>
    <string name="walk_notif_point_1">隐藏或显示滑条</string>
    <string name="walk_notif_point_2">设置和停止</string>
    <string name="walk_notif_point_3">应用关闭时也可用</string>
    <string name="walk_notif_point_4">随时可以关闭</string>
    <string name="walk_access_chip">无障碍</string>
    <string name="walk_access_title">音量键即时响应</string>
    <string name="walk_access_subtitle">可选。开启 Gesture Volume 无障碍服务后，按下音量键会立即打开快捷滑块，并且可以从滑条和 Deck 使用锁屏和截屏。</string>
    <string name="walk_access_animation">无障碍开关开启，按下音量键，快捷滑块在旁边打开。</string>
    <string name="walk_access_card">它只用于你开启的功能，任何数据都不会离开你的手机。在打开设置之前，你会看到它具体做什么。</string>
    <string name="walk_access_granted">无障碍已开启 ✓</string>
    <string name="walk_access_point_1">音量键打开滑块</string>
    <string name="walk_access_point_2">锁屏和截屏</string>
    <string name="walk_access_point_3">数据不离开手机</string>
    <string name="walk_access_point_4">随时可以关闭</string>
