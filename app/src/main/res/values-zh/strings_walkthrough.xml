    <string name="walk_intro_chip">GESTURE VOLUME</string>
    <string name="walk_intro_title">屏幕边缘的音量控制</string>
    <string name="walk_intro_subtitle">一个小滑条停在屏幕侧边。滑动它即可调节音量，点按它即可打开音量面板。</string>
    <string name="walk_intro_caption">上滑 · 下滑</string>
    <string name="walk_intro_animation">手指上下滑动滑条，音量随之升高和降低。</string>
