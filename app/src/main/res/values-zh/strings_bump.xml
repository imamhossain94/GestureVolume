<?xml version="1.0" encoding="utf-8"?>
<resources>
    <string name="volume_limited_by_system">Android 将音量限制在此处。接受听力保护提示后才能调得更大。</string>
    <string name="volume_method_title">音量的调节方式</string>
    <string name="volume_method_desc">如果音量调不到最大，或滑动后又弹回原处，请换一种方式。</string>
    <string name="volume_method_auto">自动</string>
    <string name="volume_method_auto_desc">设置精确的音量并检查是否生效。如果 Android 或耳机拒绝或将其改回，滑条会像音量键一样调节音量。</string>
    <string name="volume_method_keys">像音量键一样</string>
    <string name="volume_method_keys_desc">每一步都相当于按一次音量键，因此会跟随投屏、蓝牙以及自带音量的应用。显示的音量会稍后更新。</string>
    <string name="volume_method_precise">仅精确音量</string>
    <string name="volume_method_precise_desc">始终设置精确音量，与早期版本相同。</string>
    <string name="visibility_a11y_title">置于最上层</string>
    <string name="visibility_a11y_desc">无障碍服务可以把滑条绘制在状态栏和摄像头之上，在会隐藏悬浮窗的应用里也能显示。</string>
    <string name="visibility_a11y_draw_title">通过无障碍服务绘制</string>
    <string name="visibility_a11y_draw_desc">滑条可以紧贴屏幕边缘停在状态栏上，并在会隐藏其他应用悬浮窗的应用和视频中继续显示。手机锁定时它会让开。</string>
    <string name="bump_title">按键动画</string>
    <string name="bump_card_subtitle">屏幕会回应你按下的每个按键</string>
    <string name="bump_enable_title">为音量键添加动画</string>
    <string name="bump_enable_desc">在你按下的按键旁播放带音量级别的动画，取代系统的滑块。</string>
    <string name="bump_needs_accessibility">需要无障碍服务才能立即响应按键并隐藏系统滑块。没有它时，动画会在系统滑块出现片刻后才显示。</string>
    <string name="bump_needs_service">请在主屏幕打开 Gesture Volume，按键才会播放此动画。</string>
    <string name="bump_style_title">动画</string>
    <string name="bump_style_desc">所有动画都免费。点按一个即可在上方的手机上查看。</string>
