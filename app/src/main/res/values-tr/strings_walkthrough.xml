    <string name="walk_style_simple_desc">Yuvarlak bir düğme. Ses için kaydır, ses paneli için dokun. Öğrenecek başka bir şey yok.</string>
    <string name="walk_style_advanced_title">Gelişmiş</string>
    <string name="walk_style_advanced_desc">Hızlı kaydırıcı, kısayollarla dolu Deck ve uzun basma menüsüyle Dock sekmesi.</string>
