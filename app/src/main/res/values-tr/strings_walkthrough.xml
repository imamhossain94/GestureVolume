    <string name="walk_style_tour_title">Kullanmanın iki yolu</string>
    <string name="walk_style_tour_subtitle_simple">Basit moddasın. Neler eklediğini görmek için Gelişmiş’e dokun. Gerçekten geçiş yapmak için ana ekranı kullan.</string>
    <string name="walk_style_tour_subtitle_advanced">Gelişmiş moddasın. Diğer yolu görmek için Basit’e dokun. Gerçekten geçiş yapmak için ana ekranı kullan.</string>
    <string name="walk_simple_chip">NASIL ÇALIŞIR</string>
    <string name="walk_simple_title">Kaydır, dokun, basılı tut</string>
    <string name="walk_simple_subtitle">Sesi değiştirmek için düğmede yukarı veya aşağı kaydır. Ses paneli için ona dokun. Her yere taşımak için basılı tut.</string>
    <string name="walk_simple_caption">Kaydır · Dokun · Basılı tut</string>
    <string name="walk_simple_animation">Bir parmak sesi yükseltmek için düğmeyi kaydırıyor, ses panelini açmak için ona dokunuyor, sonra basılı tutup taşıyor.</string>
    <string name="walk_simple_point_1">Yukarı kaydır – daha yüksek</string>
    <string name="walk_simple_point_2">Aşağı kaydır – daha kısık</string>
    <string name="walk_simple_point_3">Dokun – ses paneli</string>
    <string name="walk_simple_point_4">Basılı tut – taşı</string>
    <string name="walk_slider_chip">HIZLI KAYDIRICI</string>
    <string name="walk_slider_title">Çubuğu çekip kaydırıcıya dönüştür</string>
    <string name="walk_slider_subtitle">Çubukta yukarı veya aşağı kaydır, tam boy bir ses kaydırıcısına dönüşsün. Seviyeyi ayarlamak için kaydırmaya devam et.</string>
    <string name="walk_slider_caption">Kaydır · Sürdür</string>
    <string name="walk_slider_animation">Bir parmak çubuğu sürüklüyor; çubuk, seviyesi parmağı izleyen uzun bir ses kaydırıcısına dönüşüyor.</string>
    <string name="walk_slider_point_1">Yukarı kaydır – daha yüksek</string>
    <string name="walk_slider_point_2">Aşağı kaydır – daha kısık</string>
    <string name="walk_slider_point_3">Sürdür – seviyeyi ayarla</string>
    <string name="walk_slider_point_4">Tam boy kaydırıcı</string>
    <string name="walk_deck_chip">DECK</string>
    <string name="walk_deck_title">Kısayolların bir kaydırma uzağında</string>
    <string name="walk_deck_subtitle">Deck’i açmak için çubuktan içeri kaydır: uygulamalar, anahtarlar, hızlı arama ve daha fazlası.</string>
    <string name="walk_deck_caption">İçeri kaydır</string>
    <string name="walk_deck_animation">Bir parmak çubuktan içeri kaydırıyor ve kısayol kutucuklarından oluşan bir panel kayarak açılıyor.</string>
    <string name="walk_deck_point_1">İçeri kaydır – aç</string>
    <string name="walk_deck_point_2">Uygulamalar</string>
    <string name="walk_deck_point_3">Anahtarlar</string>
    <string name="walk_deck_point_4">Hızlı arama</string>
    <string name="walk_menu_chip">UZUN BASMA MENÜSÜ</string>
    <string name="walk_menu_title">Geri kalan her şey için basılı tut</string>
    <string name="walk_menu_subtitle">Bir eylem menüsü açmak için çubuğu basılı tut: ekran görüntüsü, kilit, fener ve daha fazlası. Çubuğu taşımak için basılı tut ve sürükle.</string>
    <string name="walk_menu_caption">Basılı tut · Sürükle</string>
    <string name="walk_menu_animation">Bir parmak çubuğu basılı tutuyor ve yanında bir eylem ızgarası açılıyor.</string>
    <string name="walk_menu_point_1">Basılı tut – menüyü aç</string>
    <string name="walk_menu_point_2">Basılı tut ve sürükle – taşı</string>
    <string name="walk_menu_point_3">Ekran görüntüsü ve kilit</string>
    <string name="walk_menu_point_4">Fener ve daha fazlası</string>
    <string name="walk_move_chip">TAŞI</string>
    <string name="walk_move_title">Başparmağının olduğu yere koy</string>
    <string name="walk_move_subtitle">Çubuk soluklaşıp oklar gösterene kadar basılı tut, sonra istediğin yere sürükle: yukarı, aşağı ya da karşı tarafa. Bırakınca yakın kenara yerleşir.</string>
    <string name="walk_move_caption">Basılı tut · Sürükle · Bırak</string>
    <string name="walk_move_animation">Bir parmak çubuğu oklar görünene kadar basılı tutuyor, ekranda aşağı ve karşıya sürüklüyor ve bırakıyor; çubuk diğer kenara yerleşiyor.</string>
    <string name="walk_move_point_1">Basılı tut – kaldır</string>
    <string name="walk_move_point_2">Sürükle – her yere</string>
    <string name="walk_move_point_3">Bırak – kenarı bulur</string>
    <string name="walk_move_point_4">Bıraktığın yerde kalır</string>
    <string name="walk_permission_chip">İZİN</string>
    <string name="walk_permission_title">Çubuğa ekranda izin ver</string>
    <string name="walk_permission_subtitle">Android, çubuğun diğer uygulamaların üstünde durabilmesi için Gesture Volume’un diğer uygulamaların üzerinde görüntülenmesine izin vermeni ister.</string>
    <string name="walk_permission_animation">Diğer uygulamaların üzerinde görüntüle anahtarı açılıyor ve çubuk ekranın kenarında beliriyor.</string>
    <string name="walk_permission_point_1">Diğer uygulamaların üzerinde görüntüle</string>
    <string name="walk_permission_point_2">Çubuğu üstte tutar</string>
    <string name="walk_permission_point_3">Ayarlar’da tek bir anahtar</string>
    <string name="walk_permission_point_4">İstediğin zaman kapat</string>
    <string name="walk_notif_chip">BİLDİRİMLER</string>
    <string name="walk_notif_title">Bildirimlerinde denetimler</string>
    <string name="walk_notif_subtitle">İsteğe bağlı. Bildirimlere izin ver, çubuğun denetimleri bildirim panelinde beklesin: uygulama kapalıyken bile çubuğu gizle veya göster, ayarları aç ya da durdur.</string>
    <string name="walk_notif_animation">Bildirim isteğinde İzin ver’e dokunuluyor ve bildirim paneli, içinde çubuğun denetimleriyle aşağı iniyor.</string>
    <string name="walk_notif_card">Uygulama kapalıyken gizlediğin bir çubuğa geri dönmenin tek yolu budur. Gesture Volume başka hiçbir bildirim göndermez.</string>
    <string name="walk_notif_granted">Bildirimler açık ✓</string>
    <string name="walk_notif_point_1">Çubuğu gizle veya göster</string>
    <string name="walk_notif_point_2">Ayarlar ve Durdur</string>
    <string name="walk_notif_point_3">Uygulama kapalıyken çalışır</string>
    <string name="walk_notif_point_4">İstediğin zaman kapat</string>
    <string name="walk_access_chip">ERİŞİLEBİLİRLİK</string>
    <string name="walk_access_title">Anında ses tuşları</string>
    <string name="walk_access_subtitle">İsteğe bağlı. Gesture Volume erişilebilirlik hizmetini aç; böylece bir ses tuşu Hızlı kaydırıcıyı hemen açar, Ekranı kilitle ve Ekran görüntüsü de çubuktan ve Deck’ten çalışır.</string>
    <string name="walk_access_animation">Erişilebilirlik anahtarı açılıyor, bir ses tuşuna basılıyor ve Hızlı kaydırıcı yanında açılıyor.</string>
    <string name="walk_access_card">Yalnızca açtığın özellikler için kullanılır ve hiçbir şey telefonundan çıkmaz. Ayarlar açılmadan önce tam olarak ne yaptığını göreceksin.</string>
    <string name="walk_access_granted">Erişilebilirlik açık ✓</string>
    <string name="walk_access_point_1">Ses tuşları kaydırıcıyı açar</string>
    <string name="walk_access_point_2">Ekranı kilitle ve Ekran görüntüsü</string>
    <string name="walk_access_point_3">Hiçbir şey telefonundan çıkmaz</string>
