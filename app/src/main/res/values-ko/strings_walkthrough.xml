    <string name="walk_start">시작</string>
    <string name="walk_active_edge">활성 가장자리</string>
    <string name="walk_intro_chip">GESTURE VOLUME</string>
    <string name="walk_intro_title">화면 가장자리에서 조절하는 볼륨</string>
    <string name="walk_intro_subtitle">화면 옆에 작은 바가 있습니다. 스와이프하면 볼륨이 바뀌고, 탭하면 볼륨 패널이 열립니다.</string>
    <string name="walk_intro_caption">위로 스와이프 · 아래로 스와이프</string>
    <string name="walk_intro_animation">손가락이 바를 위아래로 스와이프하면 볼륨 레벨이 함께 오르내립니다.</string>
    <string name="walk_intro_point_1">위로 스와이프 – 크게</string>
    <string name="walk_intro_point_2">아래로 스와이프 – 작게</string>
    <string name="walk_intro_point_3">탭 – 볼륨 패널</string>
    <string name="walk_intro_point_4">어떤 앱 위에도 표시</string>
    <string name="walk_style_chip">스타일 선택</string>
    <string name="walk_style_title">어떻게 사용할까요?</string>
    <string name="walk_style_subtitle">홈 화면에서 언제든지 바꿀 수 있습니다.</string>
    <string name="walk_style_simple_title">간단</string>
    <string name="walk_style_simple_desc">둥근 버튼입니다. 스와이프하면 볼륨, 탭하면 볼륨 패널. 더 배울 것이 없습니다.</string>
    <string name="walk_style_advanced_title">고급</string>
    <string name="walk_style_advanced_desc">빠른 슬라이더, 바로가기 덱, 길게 누르기 메뉴가 있는 도크 탭입니다.</string>
    <string name="walk_style_simple_point_1">스와이프 – 볼륨</string>
    <string name="walk_style_simple_point_2">탭 – 볼륨 패널</string>
    <string name="walk_style_simple_point_3">길게 누르기 – 이동</string>
    <string name="walk_style_advanced_point_1">빠른 슬라이더</string>
    <string name="walk_style_advanced_point_2">바로가기 덱</string>
    <string name="walk_style_advanced_point_3">길게 누르기 메뉴</string>
    <string name="walk_style_point_change">언제든지 변경 가능</string>
    <string name="walk_style_tour_chip">두 가지 스타일</string>
    <string name="walk_style_tour_title">두 가지 사용 방법</string>
    <string name="walk_style_tour_subtitle_simple">지금은 간단 모드입니다. 고급을 눌러 무엇이 추가되는지 보세요. 실제 전환은 홈 화면에서 합니다.</string>
    <string name="walk_style_tour_subtitle_advanced">지금은 고급 모드입니다. 간단을 눌러 다른 방식을 보세요. 실제 전환은 홈 화면에서 합니다.</string>
    <string name="walk_simple_chip">사용 방법</string>
    <string name="walk_simple_title">스와이프, 탭, 길게 누르기</string>
    <string name="walk_simple_subtitle">버튼을 위나 아래로 스와이프해 볼륨을 바꾸세요. 탭하면 볼륨 패널이 열립니다. 길게 누르면 어디로든 옮길 수 있습니다.</string>
    <string name="walk_simple_caption">스와이프 · 탭 · 길게 누르기</string>
    <string name="walk_simple_animation">손가락이 버튼을 스와이프해 볼륨을 높이고, 탭해 볼륨 패널을 연 다음, 길게 눌러 옮깁니다.</string>
    <string name="walk_simple_point_1">위로 스와이프 – 크게</string>
    <string name="walk_simple_point_2">아래로 스와이프 – 작게</string>
    <string name="walk_simple_point_3">탭 – 볼륨 패널</string>
    <string name="walk_simple_point_4">길게 누르기 – 이동</string>
    <string name="walk_slider_chip">빠른 슬라이더</string>
    <string name="walk_slider_title">바를 당겨 슬라이더로</string>
    <string name="walk_slider_subtitle">바를 위나 아래로 스와이프하면 화면 높이만 한 볼륨 슬라이더로 늘어납니다. 계속 밀어서 레벨을 정하세요.</string>
    <string name="walk_slider_caption">스와이프 · 밀기</string>
    <string name="walk_slider_animation">손가락이 바를 끌면 바가 긴 볼륨 슬라이더로 늘어나고, 레벨이 손가락을 따라갑니다.</string>
    <string name="walk_slider_point_1">위로 스와이프 – 크게</string>
    <string name="walk_slider_point_2">아래로 스와이프 – 작게</string>
    <string name="walk_slider_point_3">밀기 – 레벨 설정</string>
    <string name="walk_slider_point_4">전체 높이 슬라이더</string>
    <string name="walk_deck_chip">덱</string>
    <string name="walk_deck_title">스와이프 한 번이면 바로가기</string>
    <string name="walk_deck_subtitle">바에서 안쪽으로 스와이프하면 덱이 열립니다. 앱, 토글, 단축 다이얼 등이 있습니다.</string>
    <string name="walk_deck_caption">안쪽으로 스와이프</string>
    <string name="walk_deck_animation">손가락이 바에서 안쪽으로 스와이프하면 바로가기 타일 패널이 밀려 나옵니다.</string>
    <string name="walk_deck_point_1">안쪽으로 스와이프 – 열기</string>
    <string name="walk_deck_point_2">앱</string>
    <string name="walk_deck_point_3">토글</string>
    <string name="walk_deck_point_4">단축 다이얼</string>
    <string name="walk_menu_chip">길게 누르기 메뉴</string>
    <string name="walk_menu_title">그 밖의 모든 것은 길게 누르기로</string>
    <string name="walk_menu_subtitle">바를 길게 누르면 스크린샷, 잠금, 손전등 등 동작 메뉴가 열립니다. 길게 누른 채 끌면 바를 옮길 수 있습니다.</string>
    <string name="walk_menu_caption">길게 누르기 · 끌기</string>
    <string name="walk_menu_animation">손가락이 바를 길게 누르면 옆에 동작 격자가 열립니다.</string>
    <string name="walk_menu_point_1">길게 누르기 – 메뉴 열기</string>
    <string name="walk_menu_point_2">길게 눌러 끌기 – 이동</string>
    <string name="walk_menu_point_3">스크린샷과 잠금</string>
    <string name="walk_menu_point_4">손전등 등</string>
    <string name="walk_move_chip">옮기기</string>
    <string name="walk_move_title">엄지가 닿는 곳에 두세요</string>
    <string name="walk_move_subtitle">바가 흐려지고 화살표가 보일 때까지 길게 누른 다음, 위, 아래, 또는 반대쪽까지 어디로든 끌어 옮기세요. 손을 떼면 가까운 가장자리에 자리 잡습니다.</string>
    <string name="walk_move_caption">길게 누르기 · 끌기 · 놓기</string>
    <string name="walk_move_animation">손가락이 화살표가 보일 때까지 바를 길게 누르고, 화면 아래쪽과 반대편으로 끈 다음 놓으면, 바가 반대쪽 가장자리에 자리 잡습니다.</string>
    <string name="walk_move_point_1">길게 누르기 – 들어 올리기</string>
    <string name="walk_move_point_2">끌기 – 어디로든</string>
    <string name="walk_move_point_3">놓기 – 가장자리에 붙음</string>
    <string name="walk_move_point_4">놓은 자리에 그대로</string>
    <string name="walk_permission_chip">권한</string>
    <string name="walk_permission_title">화면에 바 표시 허용</string>
    <string name="walk_permission_subtitle">바가 다른 앱 위에 표시될 수 있도록 Android에서 Gesture Volume의 다른 앱 위에 표시를 허용해 달라고 요청합니다.</string>
    <string name="walk_permission_animation">다른 앱 위에 표시 스위치가 켜지고, 화면 가장자리에 바가 나타납니다.</string>
    <string name="walk_permission_point_1">다른 앱 위에 표시</string>
    <string name="walk_permission_point_2">바를 맨 위에 유지</string>
    <string name="walk_permission_point_3">설정의 스위치 하나</string>
    <string name="walk_permission_point_4">언제든지 끌 수 있음</string>
    <string name="walk_notif_chip">알림</string>
    <string name="walk_notif_title">알림에서 바로 컨트롤</string>
    <string name="walk_notif_subtitle">선택 사항입니다. 알림을 허용하면 앱을 닫아도 알림 창에서 바를 숨기거나 표시하고, 설정을 열거나, 중지할 수 있습니다.</string>
    <string name="walk_notif_animation">알림 요청에서 허용을 누르면 알림 창이 내려오고 그 안에 바 컨트롤이 있습니다.</string>
    <string name="walk_notif_card">앱이 닫혀 있을 때 숨긴 바를 되돌릴 수 있는 유일한 방법입니다. Gesture Volume은 다른 알림을 보내지 않습니다.</string>
    <string name="walk_notif_granted">알림 켜짐 ✓</string>
    <string name="walk_notif_point_1">바 숨기기 또는 표시</string>
    <string name="walk_notif_point_2">설정 및 중지</string>
    <string name="walk_notif_point_3">앱이 닫혀 있어도 작동</string>
    <string name="walk_notif_point_4">언제든지 끌 수 있음</string>
    <string name="walk_access_chip">접근성</string>
    <string name="walk_access_title">즉시 반응하는 볼륨 키</string>
    <string name="walk_access_subtitle">선택 사항입니다. Gesture Volume 접근성 서비스를 켜면 볼륨 키를 누르는 즉시 빠른 슬라이더가 열리고, 바와 덱에서 화면 잠금과 스크린샷을 사용할 수 있습니다.</string>
    <string name="walk_access_animation">접근성 스위치가 켜지고 볼륨 키를 누르면 옆에 빠른 슬라이더가 열립니다.</string>
    <string name="walk_access_card">켠 기능에만 사용되며, 휴대폰 밖으로 나가는 것은 없습니다. 설정이 열리기 전에 정확히 무엇을 하는지 보여 드립니다.</string>
    <string name="walk_access_granted">접근성 켜짐 ✓</string>
    <string name="walk_access_point_1">볼륨 키로 슬라이더 열기</string>
    <string name="walk_access_point_2">화면 잠금과 스크린샷</string>
    <string name="walk_access_point_3">휴대폰 밖으로 나가지 않음</string>
    <string name="walk_access_point_4">언제든지 끌 수 있음</string>
</resources>
